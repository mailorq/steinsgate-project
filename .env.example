# Скопируйте в .env в корне репозитория: его читают и docker compose, и локальный запуск.
# Никогда не коммитьте заполненный файл.

# Обязателен при DEBUG=False, иначе приложение не стартует
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Значение должно быть URL-safe: символ $ docker compose трактует как
# подстановку переменной и портит секрет
SECRET_KEY=

EMAIL_DELIVERY_QUOTA_SECRET=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Host port of the frontend container. PostgreSQL and Redis are not published.
APP_PORT=4173

DB_NAME=steinsgate
DB_USER=steinsgate
DB_PASSWORD=
# DB_HOST/DB_PORT для локального запуска; в compose перекрываются значениями сервиса db
DB_HOST=127.0.0.1
DB_PORT=5432

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_TIMEOUT=10
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Потолок писем с кодом на весь сайт за сутки. 250 держат расход ниже суточного
# лимита личного Gmail (около 500 получателей); для Google Workspace можно до 1000
# EMAIL_DELIVERY_DAILY_LIMIT=250

# Redis для троттлинга, блокировок и кэша; в compose задается сервисом
# REDIS_URL=redis://127.0.0.1:6379/0
# Брокер Celery; в compose задается сервисом redis-broker.
# Без него задачи выполняются синхронно в процессе Django
# CELERY_BROKER_URL=redis://127.0.0.1:6380/0

# Схема API (/api/docs). По умолчанию включена только при DEBUG=True
# API_DOCS_ENABLED=False
# Число доверенных прокси перед Django. 1 - локальный/demo nginx;
# 2 - production: TLS-прокси хоста + nginx из compose.
# NINJA_NUM_PROXIES=2
# HTTPS-контур: редирект на https, Secure-cookie и HSTS переключаются вместе.
# в production обязателен TLS-прокси хоста, который перезаписывает x-forwarded-proto;
# False допустим только для локального/demo запуска на loopback
# HTTPS_ENABLED=False
